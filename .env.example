# Environment variables needed to connect to LiveKit.
# Local livekit-server --dev defaults:
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
# LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=<your_livekit_api_key>
LIVEKIT_API_SECRET=<your_livekit_api_secret>
LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud

# Agent dispatch (https://docs.livekit.io/agents/server/agent-dispatch)
# This must match the worker started with pnpm agent:dev / pnpm agent:start.
AGENT_NAME=teacher

# AI provider keys for the teacher agent worker.
OPENAI_API_KEY=<your_openai_api_key>
ELEVEN_API_KEY=<your_elevenlabs_api_key>
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Optional model/runtime tuning.
OPENAI_LLM_MODEL=gpt-4.1-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
ELEVENLABS_MODEL=eleven_flash_v2_5
AGENT_LANGUAGE=en

# Internally used environment variables
NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
SANDBOX_ID=
